# HSM — library path selects the PKCS#11 backend
# Dev (SoftHSM2):  softhsm2-util --init-token --slot 0 --label "acquire-dev" --pin 1234 --so-pin 1234
# Prod (Luna):     set HSM_LIB to the Luna client shared library
HSM_LIB=/usr/lib/softhsm/libsofthsm2.so
HSM_SLOT=0
HSM_PIN=1234
KEK_LABEL=acquire-kek-v1

# Chain
CHAIN_ID=100
PRIVATE_NET_ID=8000

# Bridge chain IDs — SOURCE is where BridgeLock lives, DEST is where BridgeRelease lives
# Example: private chain (8000) → Ethereum Mainnet (1)
SOURCE_CHAIN_ID=8000
DEST_CHAIN_ID=1
DEST_CHAIN_NAME=eth

# RPC (HTTP for most ops; SOURCE_RPC_URL must be WS for event subscription)
RPC_URL=http://erigon:8545
SOURCE_RPC_URL=ws://private-chain:8546
DEST_RPC_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Contract addresses (set after deployment)
BRIDGE_LOCK_ADDR=0xdA65811668b62C79Ccc6e2705FfC219824b39C2F
BRIDGE_RELEASE_ADDR=0x_DEPLOY_BRIDGERELEASE_ON_MAINNET_FIRST

# Signer service
LISTEN_ADDR=172.22.0.10:8443
TLS_CERT=/certs/signer.crt
TLS_KEY=/certs/signer.key
SIGNING_SUBNET=172.22.0.0/24

# Audit
AUDIT_LOG=/var/log/acquire/audit.jsonl

# Cloudflare Zero Trust
CF_TOKEN=<cloudflare-token>
