# HSM
HSM_SLOT=0
HSM_PIN=<luna-pin>
KEK_LABEL=acquire-kek-v1

# Chain
CHAIN_ID=100
PRIVATE_NET_ID=8000

# RPC (HTTP for most ops; SOURCE_RPC_URL must be WS for event subscription)
RPC_URL=http://erigon:8545
SOURCE_RPC_URL=ws://private-chain:8546
DEST_RPC_URL=ws://erigon:8546

# Signer service
LISTEN_ADDR=172.22.0.10:8443
TLS_CERT=/certs/signer.crt
TLS_KEY=/certs/signer.key
SIGNING_SUBNET=172.22.0.0/24

# Audit
AUDIT_LOG=/var/log/acquire/audit.jsonl

# Cloudflare Zero Trust
CF_TOKEN=<cloudflare-token>
